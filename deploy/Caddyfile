# Caddyfile de SIGAC. deploy/remote.sh reemplaza __DOMINIO__ por el dominio real.
# Caddy obtiene y renueva solo el certificado de Let's Encrypt.
__DOMINIO__ {
	encode zstd gzip

	# API: se reenvía tal cual, SIN quitar el prefijo /api (por eso `handle` y no `handle_path`).
	handle /api/* {
		reverse_proxy 127.0.0.1:3000
	}

	# Frontend como SPA: cualquier ruta desconocida cae en index.html.
	handle {
		root * /srv/sigac
		try_files {path} /index.html
		file_server
	}
}
