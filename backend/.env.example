# Conexiones a Base de Datos (Principio de Mínimo Privilegio)

# 1. Autenticación (Uso exclusivo para endpoints de Login)
DB_URL_AUTH="postgres://sigac_auth:Auth_Pass_Super_Seguro_1!@localhost:5432/sigac-db"

# 2. Público (Uso exclusivo para la landing page informativa - Solo Lectura)
DB_URL_PUBLIC="postgres://sigac_publico:Public_Pass_Super_Seguro_2!@localhost:5432/sigac-db"

# 3. Reportes (Uso exclusivo para dashboard administrativo - Solo Lectura)
DB_URL_REPORTS="postgres://sigac_reportes:Report_Pass_Super_Seguro_3!@localhost:5432/sigac-db"

# 4. API Core (Operaciones de negocio y cron jobs - CRUD sin DELETE)
DB_URL_API="postgres://sigac_api:Api_Pass_Super_Seguro_4!@localhost:5432/sigac-db"

# JWT Secret Key
JWT_SECRET=change_this_to_a_secure_random_secret
